	sh:property
		[ sh:path observable_ai_ext:detectionMethod ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
		[ sh:path observable_ai_ext:encryptionType ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
		[ sh:path observable_ai_ext:detectionStatus ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
		[ sh:path observable_ai_ext:entropyValue ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
	.

