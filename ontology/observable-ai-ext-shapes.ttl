# SHACL shapes for observable-ai-ext. OWL definitions in observable-ai-ext.ttl.
# CDO Playground: separate shapes file for testing (see CDO-Playground-Instructions.md).

@prefix observable_ai_ext: <https://ontology.unifiedcyberontology.org/uco/observable-ai-ext/> .
@prefix observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix uco-tool: <https://ontology.unifiedcyberontology.org/uco/tool/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# 1) Forensic Extraction Provenance
observable_ai_ext:ForensicExtractionFacetShape
	a sh:NodeShape ;
	sh:targetClass observable_ai_ext:ForensicExtractionFacet ;
	sh:property
		[ sh:path observable_ai_ext:sourceFile ; sh:class observable:File ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
		[ sh:path observable_ai_ext:sourceRecordLocator ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
		[ sh:path observable_ai_ext:sourceByteOffset ; sh:datatype xsd:nonNegativeInteger ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
		[ sh:path observable_ai_ext:extractionTool ; sh:class uco-tool:ConfiguredTool ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
		[ sh:path observable_ai_ext:extractionAction ; sh:class uco-action:Action ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
	.

# 2) Windows Event Record Enrichment
observable_ai_ext:WindowsEventRecordFacetShape
	a sh:NodeShape ;
	sh:targetClass observable_ai_ext:WindowsEventRecordFacet ;
	sh:property
		[ sh:path observable_ai_ext:eventChannel ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
		[ sh:path observable_ai_ext:eventProvider ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
		[ sh:path observable_ai_ext:eventComputer ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
		[ sh:path observable_ai_ext:subjectAccount ; sh:class observable:ObservableObject ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
		[ sh:path observable_ai_ext:targetAccount ; sh:class observable:ObservableObject ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
		[ sh:path observable_ai_ext:logonId ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
	.

# 3) Memory Image (no property constraints)
observable_ai_ext:MemoryImageShape
	a sh:NodeShape ;
	sh:targetClass observable_ai_ext:MemoryImage ;
	.

# 3) Memory Image Facet
observable_ai_ext:MemoryImageFacetShape
	a sh:NodeShape ;
	sh:targetClass observable_ai_ext:MemoryImageFacet ;
	sh:property
		[ sh:path observable_ai_ext:acquiredTime ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
		[ sh:path observable_ai_ext:memoryFormat ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
		[ sh:path observable_ai_ext:architecture ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
	.

# 5) Encryption Detection Facet
